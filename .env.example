# ============================================================================
#  Ayala Kids backend — пример конфигурации окружения
#  Скопируйте этот файл в .env и заполните своими значениями:
#     cp .env.example .env         (Linux/macOS)
#     Copy-Item .env.example .env  (PowerShell)
#
#  Файл .env в git НЕ попадает (см. .gitignore) — храните секреты только там.
# ============================================================================

# ----------------------------------------------------------------------------
#  База данных (PostgreSQL)
#  Заполняете по частям — строка подключения DATABASE_URL для Prisma
#  собирается из них автоматически в config/database.js.
# ----------------------------------------------------------------------------
DATABASE_NAME=ayala_kids
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SSL=false

# Необязательно: готовая строка подключения. Если задана — перекрывает части
# выше (удобно для облачных БД: Supabase, Neon, Railway и т.п.).
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public&sslmode=require"

# ----------------------------------------------------------------------------
#  Сервер
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ----------------------------------------------------------------------------
#  Безопасность / доступ администратора
# ----------------------------------------------------------------------------
# Мастер-пароль админ-панели. ОБЯЗАТЕЛЬНО поменяйте на проде!
ADMIN_PASSWORD=ayala2026

# Секрет для подписи токенов (HMAC-SHA256). Длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
